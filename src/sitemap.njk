---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in collections.all | sort(false, false, "url") %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.url }}{{ p.url | versLangue('fr') }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ p.url | versLangue('en') }}"/>
  </url>
{%- endfor %}
</urlset>
