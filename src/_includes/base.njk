<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description | safe }}">
  <meta name="theme-color" content="{{ themeColor }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ page.url | versLangue('fr') }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url | versLangue('en') }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ i18n[lang].locale }}">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{{ title | safe }}">
  <meta property="og:description" content="{{ ogDescription | safe }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

{% include "entete.njk" %}

<main>
{{ content | safe }}
</main>

{% include "pied.njk" %}

</body>
</html>
