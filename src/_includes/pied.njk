{%- set t = i18n[lang] -%}
<!-- FOOTER -->
<footer class="pied">
  <p class="logo">{{ site.nom }}</p>
  <p class="metier">{{ t.pied.metier }}</p>
  <p class="mentions">
    <small>© {{ site.annee }} {{ site.nom }}</small>
    <small class="langues" role="group" aria-label="{{ t.pied.langue }}"><a href="{{ page.url | versLangue('fr') }}" lang="fr" hreflang="fr"{% if lang == "fr" %} aria-current="true"{% endif %}>Français</a><a href="{{ page.url | versLangue('en') }}" lang="en" hreflang="en"{% if lang == "en" %} aria-current="true"{% endif %}>English</a></small>
  </p>
</footer>
